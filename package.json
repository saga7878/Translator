{
  "name": "translator",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "Ninja",
  "version": "0.1.5",
  "icon": "icon.png",
  "repository": "https://github.com/saga7878/Translator.git",
  "private": "true",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.translator",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "translator.copy",
        "title": "%command.copy%"
      },
      {
        "command": "translator.replace",
        "title": "%command.replace%"
      },
      {
        "command": "translator.translateHover",
        "title": "%command.translateHover%"
      },
      {
        "command": "translator.translate",
        "title": "%command.translate%"
      },
      {
        "command": "translator.translateAndReplace",
        "title": "%command.translateAndReplace%"
      },
      {
        "command": "translator.openPanel",
        "title": "%command.openPanel%",
        "icon": "$(globe)"
      },
      {
        "command": "translator.quickTranslate",
        "title": "Quick Translate"
      },
      {
        "command": "translator.openSettings",
        "title": "Open Settings"
      },
      {
        "command": "translator.changeSourceLanguage",
        "title": "Change Source Language"
      },
      {
        "command": "translator.changeTargetLanguage",
        "title": "Change Target Language"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "translator.menu",
          "when": "editorHasSelection",
          "group": "0_translate@1"
        }
      ],
      "translator.menu": [
        {
          "command": "translator.translateHover",
          "group": "translation@1"
        },
        {
          "command": "translator.translate",
          "group": "translation@3"
        },
        {
          "command": "translator.translateAndReplace",
          "group": "translation@2"
        }
      ],
      "view/title": []
    },
    "submenus": [
      {
        "id": "translator.menu",
        "label": "%submenu.translate%",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "translator.service": {
          "type": "string",
          "enum": [
            "copilot",
            "microsoft"
          ],
          "enumDescriptions": [
            "%config.service.copilot%",
            "%config.service.microsoft%"
          ],
          "default": "microsoft",
          "description": "%config.service.description%"
        },
        "translator.minimumTextLength": {
          "type": "number",
          "default": 2,
          "description": "%config.minimumTextLength.description%"
        },
        "translator.sourceLanguage": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-Hans",
            "en",
            "ja",
            "ko",
            "fr",
            "de",
            "es",
            "ru"
          ],
          "enumDescriptions": [
            "%language.auto%",
            "%language.zh-Hans%",
            "%language.en%",
            "%language.ja%",
            "%language.ko%",
            "%language.fr%",
            "%language.de%",
            "%language.es%",
            "%language.ru%"
          ],
          "description": "%config.sourceLanguage.description%"
        },
        "translator.targetLanguage": {
          "type": "string",
          "default": "zh-Hans",
          "enum": [
            "zh-Hans",
            "en",
            "ja",
            "ko",
            "fr",
            "de",
            "es",
            "ru"
          ],
          "enumDescriptions": [
            "%language.zh-Hans%",
            "%language.en%",
            "%language.ja%",
            "%language.ko%",
            "%language.fr%",
            "%language.de%",
            "%language.es%",
            "%language.ru%"
          ],
          "description": "%config.targetLanguage.description%"
        },
        "translator.hoverEnabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.hoverEnabled.description%"
        },
        "translator.hoverDelay": {
          "type": "number",
          "default": 300,
          "description": "%config.hoverDelay.description%"
        },
        "translator.cacheTimeout": {
          "type": "number",
          "default": 3600,
          "description": "%config.cacheTimeout.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "translator.translateHover",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --config ./build/node-extension.webpack.config.js",
    "watch": "webpack --watch --config ./build/node-extension.webpack.config.js",
    "package": "webpack --mode production --devtool hidden-source-map --config ./build/node-extension.webpack.config.js",
    "test-compile": "tsc -p ./",
    "test:translation": "mocha --ui tdd --require ts-node/register \"src/test/*.test.ts\"",
    "test-watch": "tsc -watch -p ./",
    "pretest": "yarn run test-compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/google-translate-api": "^2.3.1",
    "@types/humps": "^2.0.0",
    "@types/mocha": "^8.0.4",
    "@types/node": "^22.20.5",
    "@types/request": "^2.48.5",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^4.9.0",
    "@typescript-eslint/parser": "^4.9.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^7.15.0",
    "glob": "^7.1.6",
    "google-translate-cn-api": "^1.0.6",
    "minimatch": "^3.1.5",
    "mocha": "^8.1.3",
    "ts-loader": "^8.0.11",
    "ts-node": "^10.4.0",
    "typescript": "^5.6.3",
    "webpack": "^5.10.0",
    "webpack-cli": "^4.2.0"
  },
  "dependencies": {
    "humps": "^2.0.1",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.2.2"
  }
}
